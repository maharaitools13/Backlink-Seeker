# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_PATH=./data/app.db
BACKUP_DIR=./backups
# Session cookie is marked Secure when NODE_ENV=production (requires HTTPS)
NODE_ENV=development
# Optional email delivery for invites / alerts. If unset, invites are
# returned as copyable links in the UI (no email is sent, nothing is faked).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
APP_BASE_URL=http://localhost:3000
